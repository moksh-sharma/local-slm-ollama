# Set true to run without a local Ollama daemon (synthetic timings for CI/dev)
MOCK_OLLAMA=false

OLLAMA_BASE_URL=http://localhost:11434

# Default model for interactive chat
OLLAMA_MODEL=llama3.2:3b

# Models compared in slm-compare (comma-separated)
BENCHMARK_MODELS=llama3.2:1b,llama3.2:3b,qwen2.5:3b

# Benchmark settings
BENCHMARK_WARMUP_RUNS=1
BENCHMARK_MEASURED_RUNS=3
BENCHMARK_MAX_TOKENS=256
